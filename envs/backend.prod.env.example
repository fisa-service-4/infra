SPRING_PROFILES_ACTIVE=app,aws

# RDS PostgreSQL (운영 DB)
SPRING_DATASOURCE_URL=<RDS_ENDPOINT>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<RDS_MASTER_PASSWORD>

# Log DB (DATA EC2 postgres, port 5432)
LOG_DATASOURCE_URL=jdbc:postgresql://<DATA_EC2_PRIVATE_IP>:5432/finance_log
LOG_DATASOURCE_USERNAME=admin
LOG_DATASOURCE_PASSWORD=<POSTGRES_PASSWORD>

# Analysis DB (DATA EC2 postgres, port 5432)
ANALYTICS_DATASOURCE_URL=jdbc:postgresql://<DATA_EC2_PRIVATE_IP>:5432/finance_analytics
ANALYTICS_DATASOURCE_USERNAME=admin
ANALYTICS_DATASOURCE_PASSWORD=<POSTGRES_PASSWORD>

# Redis (DATA EC2)
SPRING_DATA_REDIS_HOST=<DATA_EC2_PRIVATE_IP>
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<REDIS_PASSWORD>

# MYDATA 서버 연동 (MYDATA EC2 VPC Private IP)
MYDATA_SERVER_URL=http://<MYDATA_EC2_PRIVATE_IP>:8084

# CORE transaction-server (VPN)
TRANSACTION_SERVER_URL=http://<CORE_VPN_OR_PUBLIC_IP>:8083

# Bank server (온프레미스, VPN)
BANK_SERVER_URL=http://<BANK_SERVER_IP>:8081
