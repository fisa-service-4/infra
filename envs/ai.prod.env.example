PROFILE=app

# APP EC2 내부 통신
BACKEND_URL=http://service-backend:8080

# LLM (Google Gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=<GEMINI_API_KEY>

# Analysis DB (DATA EC2 postgres, port 5432)
ANALYTICS_DB_HOST=<DATA_EC2_PRIVATE_IP>
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=finance_analytics
ANALYTICS_DB_SCHEMA=public
ANALYTICS_DB_USER=admin
ANALYTICS_DB_PASSWORD=<POSTGRES_PASSWORD>

# Vector DB (DATA EC2 postgres, port 5432)
VECTOR_DB_HOST=<DATA_EC2_PRIVATE_IP>
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=finance_vector
VECTOR_DB_SCHEMA=public
VECTOR_DB_USER=admin
VECTOR_DB_PASSWORD=<POSTGRES_PASSWORD>
