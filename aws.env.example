# =============================================================================
# FLON AWS 운영 환경 환경변수 마스터 레퍼런스
# 도메인: flon.cloud  |  VPC CIDR: 172.16.0.0/16
#
# 사용법:
#   각 섹션의 내용을 envs/<service>.prod.env 파일로 생성해서 사용하세요.
#   실제 .env 파일은 절대 git에 커밋하지 마세요 (.gitignore 확인).
#
# EC2 Private IP 확인:
#   - APP EC2  (FLON-APP-2A):    AWS 콘솔 → EC2 → Private IPv4 address
#   - MYDATA EC2 (FLON-MYDATA-2A): AWS 콘솔 → EC2 → Private IPv4 address
#   - DATA EC2  (FLON-DATA-2A):  AWS 콘솔 → EC2 → Private IPv4 address
#
# VPN IP (CORE 온프레미스):
#   - VPN 구축 완료 후 온프레미스 내부 IP 또는 VPN 터널 IP를 기재하세요.
#   - 미구축 시: 발표용으로 온프레미스 머신의 공인 IP를 직접 사용할 수 있습니다.
# =============================================================================


# =============================================================================
# [APP EC2] envs/frontend.prod.env
# =============================================================================

AI_SERVER_URL=http://service-ai-server:8000
BACKEND_URL=http://service-backend:8080
MYDATA_URL=http://<MYDATA_EC2_PRIVATE_IP>:8084
TRANSACTION_URL=http://<CORE_VPN_OR_PUBLIC_IP>:8083


# =============================================================================
# [APP EC2] envs/backend.prod.env
# =============================================================================

SPRING_PROFILES_ACTIVE=app

# RDS PostgreSQL (운영 DB)
SPRING_DATASOURCE_URL=jdbc:postgresql://flon-rds.cdioywgcg35u.ap-northeast-2.rds.amazonaws.com:5432/flonrdsdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<RDS_MASTER_PASSWORD>

# Log DB (DATA EC2 postgres)
LOG_DB_URL=jdbc:postgresql://<DATA_EC2_PRIVATE_IP>:5432/finance_log
LOG_DB_USERNAME=admin
LOG_DB_PASSWORD=<POSTGRES_PASSWORD>

# Redis (DATA EC2)
SPRING_DATA_REDIS_HOST=<DATA_EC2_PRIVATE_IP>
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<REDIS_PASSWORD>

# MYDATA / CORE 연동
MYDATA_URL=http://<MYDATA_EC2_PRIVATE_IP>:8084
TRANSACTION_URL=http://<CORE_VPN_OR_PUBLIC_IP>:8083


# =============================================================================
# [APP EC2] envs/ai.prod.env
# =============================================================================

PROFILE=app
BACKEND_URL=http://service-backend:8080

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=<GEMINI_API_KEY>

# Analysis DB (DATA EC2 postgres)
ANALYTICS_DB_HOST=<DATA_EC2_PRIVATE_IP>
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=finance_analytics
ANALYTICS_DB_SCHEMA=public
ANALYTICS_DB_USER=admin
ANALYTICS_DB_PASSWORD=<POSTGRES_PASSWORD>

# Vector DB (DATA EC2 postgres)
VECTOR_DB_HOST=<DATA_EC2_PRIVATE_IP>
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=finance_vector
VECTOR_DB_SCHEMA=public
VECTOR_DB_USER=admin
VECTOR_DB_PASSWORD=<POSTGRES_PASSWORD>


# =============================================================================
# [DATA EC2] envs/redis.prod.env
# =============================================================================

REDIS_PASSWORD=<REDIS_PASSWORD>


# =============================================================================
# [DATA EC2] envs/postgres.prod.env
# DB: finance_vector (기본) + finance_log + finance_analytics (init 스크립트 생성)
# =============================================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=finance_vector


# =============================================================================
# [CORE 온프레미스] envs/oracle.prod.env
# =============================================================================

ORACLE_PASSWORD=<ORACLE_SYS_PASSWORD>
APP_USER=BANK
APP_USER_PASSWORD=<BANK_USER_PASSWORD>


# =============================================================================
# [CORE 온프레미스] envs/stock.prod.env
# =============================================================================

SPRING_PROFILES_ACTIVE=core
KIS_APP_KEY=<KIS_APP_KEY>
KIS_APP_SECRET=<KIS_APP_SECRET>
KIS_BASE_URL=https://openapi.koreainvestment.com:9443


# =============================================================================
# 비고
# =============================================================================
# kafka, bank-server, transaction-server, mydata-server는 SPRING_PROFILES_ACTIVE 등을
# compose 파일에 인라인으로 선언하므로 별도 env 파일 불필요.
